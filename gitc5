#!/usr/bin/env bash
#
# gitc — add/commit helper that can auto-generate a commit message
#        (or code-review) with OpenAI.
#

PROMPT_COMMIT_MESSAGE="Summarize the following code changes as a concise commit message."
PROMPT_REVIEW="Review the following code changes and report only substantive issues (correctness, security, performance, reliability). For each bug, start a new section on its own line with one of: '### 🐞 bug:' (low/medium), '### 🐞🐞 bug:' (high), or '### 🐞🐞🐞 bug:' (critical). After the header, briefly explain impact, evidence (file/line if possible), and a concrete fix. If no issues, output 'LGTM'."
USER_PROMPT_REVIEW=""

yellow_text() { printf '\033[1;33m%s\033[0m\n' "$1"; }
red_text()    { printf '\033[1;31m%s\033[0m\n' "$1"; }
green_text()  { printf '\033[1;32m%s\033[0m\n' "$1"; }

print_usage() {
  cat <<EOF
Usage: gitc5|gitc [-a] [-r [-p "custom prompt"]] [-R <effort>] [path]
  -a   Stage all tracked changes (like \`git add -u\`)
  -r   Ask for a *review* instead of a commit message
  -p   Add a custom prompt to the review (only valid with -r)
  -R   Reasoning effort for reviews: minimal|low|medium|high (env: GITC_REASONING_EFFORT). Ignored for commit messages.
  path Path (file/dir) to add & commit
EOF
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || { red_text "Missing dependency: $1"; exit 1; }
}

gitc5() {
  need_cmd git
  need_cmd curl
  need_cmd jq

  [[ -n $OPENAI_API_KEY ]] || { red_text "OPENAI_API_KEY not set."; return 1; }

  local auto_add=false
  local review_requested=false
  local prompt="$PROMPT_COMMIT_MESSAGE"
  local diff_cmd=(git diff --cached)
  local max_tokens=256
  local model="${GITC_OPENAI_MODEL:-gpt-5-nano}"   # fast default for commit messages
  local review_model="${GITC_OPENAI_REVIEW_MODEL:-gpt-5}"
  local reasoning_effort="${GITC_REASONING_EFFORT:-low}"
  local we_staged=false

  local git_root; git_root=$(git rev-parse --show-toplevel) || return 1

  # helper: unstage all safely (works even without HEAD)
  unstage_all() {
    if git rev-parse --verify HEAD >/dev/null 2>&1; then
      git reset -q
    else
      git rm -r --cached . >/dev/null 2>&1 || true
    fi
  }

  update_diff() {
    DIFF=$("${diff_cmd[@]}");
  }

  while getopts ":ahrp:R:" opt; do
    case $opt in
      a) auto_add=true ;;
      r) 
        diff_cmd=(git diff --cached -U20)
        max_tokens=10000
        prompt="$PROMPT_REVIEW"
        model="$review_model"
        review_requested=true
        ;;
      p)
        USER_PROMPT_REVIEW="$OPTARG"
        ;;
      R)
        reasoning_effort="$OPTARG"
        ;;
      h) print_usage; return 0 ;;
      \?) print_usage; return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  local path_to_commit=$1

  # Validate incompatible options: cannot combine -a with a specific path
  if $auto_add && [[ -n $path_to_commit ]]; then
    red_text "Cannot use -a together with a specific path."
    return 1
  fi
  
  # Ensure -p is only used with -r
  if [[ -n $USER_PROMPT_REVIEW && $review_requested == false ]]; then
    red_text "Error: -p option can only be used with -r (review mode)."
    return 1
  fi

  case "$reasoning_effort" in
    ""|minimal|low|medium|high) : ;;
    *) red_text "Invalid reasoning effort: '$reasoning_effort' (expected minimal|low|medium|high)."; return 1 ;;
  esac

  # In commit mode, ignore any reasoning effort (env/CLI) to prioritize speed
  if ! $review_requested && [[ -n $reasoning_effort ]]; then
    yellow_text "Ignoring reasoning effort in commit mode."
    reasoning_effort=""
  fi

  update_diff
  if [[ -n $path_to_commit ]]; then
    if [[ -n $DIFF ]]; then
      red_text "There are already staged changes; refusing to commit a specific path."
      return 1
    fi
    echo "Adding $path_to_commit"
    git add --verbose -- "$path_to_commit" || return 1
    update_diff
    we_staged=true
  fi

  if $auto_add; then
    if [[ -n $DIFF ]]; then
      red_text "Cannot use -a when there are already staged changes."
      return 1
    fi
    yellow_text "Staging all tracked changes (-u)."
    git add -u "$git_root"
    update_diff
    we_staged=true
  fi

  if [[ -z $DIFF ]]; then
    yellow_text "No changes to commit."
    return 0
  fi

  # run pre-commit on staged files only
  if [[ -f $git_root/.pre-commit-config.yaml ]]; then
    if git diff --name-only --cached | grep -q .; then
      if ! command -v pre-commit >/dev/null 2>&1; then
        red_text "pre-commit not found but .pre-commit-config.yaml exists. Install with: pipx install pre-commit (or pip install pre-commit)"
        if $we_staged; then unstage_all; fi
        return 1
      fi
      pre-commit run || {
        red_text "Pre-commit hooks failed; fix issues and retry."
        if $we_staged; then unstage_all; fi
        return 1
      }
      update_diff
      if [[ -z $DIFF ]]; then
        yellow_text "No changes to commit after pre-commit fixes."
        return 0
      fi
    fi
  fi

  if [[ -n $USER_PROMPT_REVIEW ]]; then
    prompt="${prompt}"$'\n\n'"${USER_PROMPT_REVIEW}"
  fi

  # Build input and call OpenAI Responses API
  local combined_input; combined_input="$prompt"$'\n\n'"$DIFF"

  # Construct JSON payload robustly (always include model)
  local input_json model_json reason_json json_payload
  input_json=$(jq -Rn --arg s "$combined_input" '$s') || { red_text "Failed to encode input"; return 1; }
  model_json=$(jq -Rn --arg s "$model" '$s') || { red_text "Failed to encode model"; return 1; }
  json_payload=$(printf '{"model": %s, "input": %s, "max_output_tokens": %s' "$model_json" "$input_json" "$max_tokens")
  if [[ -n $reasoning_effort && $model == gpt-5* ]]; then
    reason_json=$(jq -Rn --arg s "$reasoning_effort" '$s') || { red_text "Failed to encode reasoning"; return 1; }
    json_payload+=$(printf ', "reasoning": {"effort": %s}' "$reason_json")
  fi
  json_payload+='}'
  local http_status response_body response

  if $review_requested; then
    yellow_text "Requesting a code review for your staged changes... (model: $model, reasoning effort: $reasoning_effort)"
  else
    yellow_text "Requesting a commit message for your staged changes... (model: $model)"
  fi

  response_body=$(curl -sS -w "\n%{http_code}" https://api.openai.com/v1/responses \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $OPENAI_API_KEY" \
      -d "$json_payload")
  http_status=$(tail -n1 <<<"$response_body")
  response=$(sed '$d' <<<"$response_body")
  if [[ ${http_status} != 2* ]]; then
    local api_err_msg
    api_err_msg=$(jq -r '.error.message // empty' <<<"$response") || true
    red_text "HTTP ${http_status}${api_err_msg:+ - $api_err_msg}"
    if $we_staged; then unstage_all; fi
    return 1
  fi

  # extract message or error, check jq success
  local model_response
  if ! model_response=$(jq -r '[.output[]? | .content[]? | select(.type=="output_text") | .text] | join("\n") // empty' <<<"$response"); then
    red_text "Failed to parse OpenAI API response with jq."
    if $we_staged; then unstage_all; fi
    return 1
  fi
  if [[ -z $model_response ]]; then
    local api_err api_status reason
    api_err=$(jq -r '.error.message // empty' <<<"$response") || true
    api_status=$(jq -r '.status // empty' <<<"$response") || true
    reason=$(jq -r '.incomplete_details.reason // empty' <<<"$response") || true
    if [[ -n $api_err ]]; then
      red_text "OpenAI API error: $api_err"
    elif [[ $api_status == "incomplete" ]]; then
      red_text "OpenAI API error: response incomplete${reason:+ (reason: $reason)}."
    else
      red_text "OpenAI API error: unknown"
    fi
    if $we_staged; then unstage_all; fi
    return 1
  fi

  # Cosmetic: if model replies exactly "LGTM" and review was requested, add a sparkles emoji prefix; otherwise print the review
  if $review_requested; then
    if [[ "$model_response" == "LGTM" ]]; then
      green_text "✨ LGTM!"
    else
      echo "$model_response"
    fi
    return 0
  fi

  printf '%s\n' "$model_response" | git commit --no-verify -F - || return 1
  green_text "Committed."

  if [[ -t 0 && -t 1 ]]; then
    if [ -n "$ZSH_VERSION" ]; then
      read "push_answer?Do you want to run 'git push'? [y/N]: "
    else
      read -p "Do you want to run 'git push'? [y/N]: " push_answer
    fi
    if [[ "$push_answer" =~ ^[Yy]$ ]]; then
      git push
    fi
  fi
}
